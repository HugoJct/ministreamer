<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <template class="MinistreamerWindow" parent="GtkApplicationWindow">
    <property name="title">Ministreamer</property>
    <property name="default-width">1280</property>
    <property name="default-height">720</property>

    <child type="titlebar">
      <object class="GtkHeaderBar" id="header">
        <child type="end">
          <object class="GtkMenuButton" id="settings">
            <property name="direction">none</property>
          </object>
        </child>
      </object>
    </child>

    <child>
      <object id="grid" class="GtkBox">
        <property name="orientation">vertical</property>
        <child>
          <object id="video" class="GtkPicture">
          </object>
        </child>
        <child>
          <object id="start_screenshare_1_button" class="GtkButton">
            <property name="label">Screenshare 1</property>
          </object>
        </child>
      </object>
    </child>
  </template>
</interface>
